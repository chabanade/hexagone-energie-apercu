# HEXAGONE ENERGIE : configuration Apache pour l'hébergement OVH
# Domaine principal : https://www.hexagone-energie.fr (à confirmer avant mise en ligne)

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# ne jamais rediriger les vérifications Let's Encrypt (renouvellement des certificats)
RewriteRule ^\.well-known/acme-challenge/ - [L]
# hexagone-energie.com et variantes sans www ou en http -> https://www.hexagone-energie.fr
RewriteCond %{HTTP_HOST} !^www\.hexagone-energie\.fr$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.hexagone-energie.fr/$1 [R=301,L]
# /index.html -> /
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 week"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
